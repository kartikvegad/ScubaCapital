# Gmail SMTP (Google App Password)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password (no spaces) into GMAIL_APP_PASSWORD

GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Where contact form submissions are delivered (comma-separated for multiple)
CONTACT_RECIPIENT=satish@scubacapital.in,connect@scubacapital.in
